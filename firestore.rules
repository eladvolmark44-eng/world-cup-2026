rules_version = '2';

// Firestore security rules for the World Cup 2026 betting app.
//
// Threat model: a small pool of players who sign in with Google. The Test-Mode
// rules left the whole database open to the public internet; these rules close
// that by requiring authentication for every read and write, and additionally
// stop one player from tampering with another player's bets.
//
// Roles:
//   • admin      — full control (matches the ⚙️ manager panel in the app).
//   • assistant  — "עוזר מאמן" coach role: may ONLY edit players' name/photo.
//                  Deliberately has NO admin-panel powers (results, points,
//                  knockout overrides, cards, etc.).
//
// Architecture note: live score/result syncing runs in the *client* (any
// signed-in player's browser writes results onto mundial2026/game), so the game
// and sync documents stay writable by any authenticated user — locking them to
// the admin would freeze results whenever the admin isn't online. The
// admin-only manager actions are gated in the app UI (isAdmin).

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return request.auth != null &&
             request.auth.uid == '8tDgIRJQDFZyiTvaR0pP8nXShgH2';
    }
    function isAssistant() {
      return request.auth != null &&
             request.auth.uid == '18QvfShudxTTsPfUJPpLhEQNp3h1';
    }

    // ── main game doc: results, group standings, KO overrides, cards … ─────
    // Read: any signed-in player. Write: any signed-in player, because the
    // live score sync runs client-side and merges results here.
    match /mundial2026/game {
      allow read, write: if signedIn();
    }

    // ── per-player bets & profile ──────────────────────────────────────────
    // Read: anyone signed in (leaderboards, revealed bets).
    // Write: the owner or the admin (full).
    // The assistant (coach) may ONLY change name/photoURL of any player — never
    // bets, scores, or anything else. Server jobs use the Admin SDK (bypass).
    match /mundial2026/game/participants/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAssistant() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'photoURL']);
    }

    // ── match chat ─────────────────────────────────────────────────────────
    // Signed-in players can read and post; only the admin can edit/remove.
    match /mundial2026/game/matchChats/{matchId}/messages/{msgId} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // ── cached player→club lookups (best-effort cache, low sensitivity) ─────
    match /mundial2026/game/playerClubs/{athleteId} {
      allow read, write: if signedIn();
    }

    // ── sync timestamps (last API poll times) ──────────────────────────────
    match /mundial2026/sync {
      allow read, write: if signedIn();
    }

    // Everything else is denied by default.
  }
}
